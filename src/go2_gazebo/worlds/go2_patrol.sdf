<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="go2_patrol">

    <!-- Zero gravity + dartsim: the Go2 body glides kinematically (VelocityControl)
         and never tips or contacts the ground; legs are animated by the
         joint-trajectory controller. The static indoor scene is generated by
         go2_scene.py (sample / import). -->
    <gravity>0 0 0</gravity>
    <physics name="1ms" type="dartsim">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Explicit systems so sensors/physics/scene run reliably. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <!-- IMU sensors are handled by a dedicated system plugin (not the Sensors
         system above); without it no /imu topic is produced. -->
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.42 0.42 0.47</ambient>
      <background>0.62 0.68 0.74</background>
      <grid>false</grid>
      <shadows>false</shadows>
    </scene>

    <!-- Flow-first lighting (iGPU): one soft directional sun with NO shadow cast
         plus two warm point fills inside the hall. Turn cast_shadows on below
         only for a screenshot. -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.78 0.76 0.7 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.45 0.1 -0.9</direction>
    </light>

    <light type="point" name="hall_fill_a">
      <cast_shadows>false</cast_shadows>
      <pose>1.5 3.0 3.2 0 0 0</pose>
      <diffuse>0.85 0.82 0.75 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation>
        <range>25</range>
        <constant>0.7</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <light type="point" name="hall_fill_b">
      <cast_shadows>false</cast_shadows>
      <pose>4.0 -3.0 2.6 0 0 0</pose>
      <diffuse>0.7 0.72 0.78 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.7</constant>
        <linear>0.06</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <!-- Warehouse floor (epoxy grey-blue). -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.30 0.33 0.36 1</ambient>
            <diffuse>0.34 0.37 0.41 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============ SCENE_BEGIN (go2_scene.py managed) ============ -->
