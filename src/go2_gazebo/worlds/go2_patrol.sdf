<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="go2_patrol">

    <!-- Zero gravity + dartsim: the Go2 body glides kinematically (VelocityControl)
         and never tips or contacts the ground; legs are animated by the
         joint-trajectory controller. -->
    <gravity>0 0 0</gravity>
    <physics name="1ms" type="dartsim">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Explicit systems so sensors/physics/scene run reliably. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <!-- IMU sensors are handled by a dedicated system plugin (not the Sensors
         system above); without it no /imu topic is produced. -->
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.5 0.5 0.5</ambient>
      <background>0.85 0.85 0.85</background>
      <grid>false</grid>
    </scene>

    <!-- Directional sun so RGB/depth cameras and lidar have light and returns. -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacles around the spawn point so the 360° lidar and cameras have returns. -->
    <model name="obstacle_box_front">
      <static>true</static>
      <pose>1.5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 1.0</size></box></geometry>
          <material><ambient>1 0.2 0.2 1</ambient><diffuse>0.9 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_cylinder_left">
      <static>true</static>
      <pose>-1.5 1.2 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.2 0.2 1 1</ambient><diffuse>0.15 0.15 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_box_right">
      <static>true</static>
      <pose>1.2 -1.5 0.6 0 0 0.4</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.4 1.2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.4 1.2</size></box></geometry>
          <material><ambient>0.2 0.9 0.2 1</ambient><diffuse>0.15 0.8 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_box_rear">
      <static>true</static>
      <pose>-2.0 -0.8 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.7 0.7 0.7</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.7 0.7 0.7</size></box></geometry>
          <material><ambient>0.9 0.6 0.1 1</ambient><diffuse>0.85 0.55 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!--GO2_MODEL_INSERT_HERE-->
  </world>
</sdf>
